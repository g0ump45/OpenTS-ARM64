+bool SidebarClass::Place_Ready_Building(void)
+{
+	if (!IsSidebarActive || !PlayerPtr) return false;
+	for (int column = 0; column < COLUMNS; ++column) {
+		StripClass & strip = Column[column];
+		for (int index = 0; index < strip.BuildableCount; ++index) {
+			StripClass::BuildType const & item = strip.Buildables[index];
+			FactoryClass * factory = item.Factory;
+			if (item.BuildableType != RTTI_BUILDINGTYPE || !factory || factory->Is_Building() || !factory->Has_Completed()) continue;
+
+			/* Make the completed item visible, then reuse the normal sidebar action. */
+			int const visible = Map.Max_Visible();
+			int const new_top = std::min(index, std::max(0, strip.BuildableCount - visible));
+			int const slot = index - new_top;
+			if (slot < 0 || slot >= visible) continue;
+			strip.TopIndex = new_top;
+			strip.IsToRedraw = true;
+			strip.Flag_To_Redraw();
+			StripClass::SelectButton[column][slot].Activate_Ready_Item();
+			return true;
+		}
+	}
+	return false;
+}
+
