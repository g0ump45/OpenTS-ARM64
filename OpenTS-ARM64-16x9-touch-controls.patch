+bool PortMaster_Map_Window_To_Frame(float x, float y, int & frame_x, int & frame_y)
+{
+	if (!Presenter.window || ScaleInfo.DestWidth <= 0 || ScaleInfo.DestHeight <= 0) return false;
+	int window_width = 0, window_height = 0;
+	SDL_GetWindowSize(Presenter.window, &window_width, &window_height);
+	if (window_width <= 0 || window_height <= 0) return false;
+	int const drawable_x = static_cast<int>(x * ScaleInfo.DrawableWidth / window_width);
+	int const drawable_y = static_cast<int>(y * ScaleInfo.DrawableHeight / window_height);
+	if (drawable_x < ScaleInfo.DestX || drawable_y < ScaleInfo.DestY ||
+		drawable_x >= ScaleInfo.DestX + ScaleInfo.DestWidth ||
+		drawable_y >= ScaleInfo.DestY + ScaleInfo.DestHeight) return false;
+	frame_x = std::clamp((drawable_x - ScaleInfo.DestX) * ScaleInfo.GameWidth / ScaleInfo.DestWidth, 0, ScaleInfo.GameWidth - 1);
+	frame_y = std::clamp((drawable_y - ScaleInfo.DestY) * ScaleInfo.GameHeight / ScaleInfo.DestHeight, 0, ScaleInfo.GameHeight - 1);
+	return true;
+}
