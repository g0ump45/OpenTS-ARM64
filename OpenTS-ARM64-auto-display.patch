+    /* Some handheld SDL backends accept the fullscreen flag but leave the window at
+     * the requested 640x480 size. Ask SDL to enter desktop fullscreen explicitly,
+     * then use the display bounds as a borderless fallback if it did not take. */
+    if ((SDL_GetWindowFlags(video->window) & SDL_WINDOW_FULLSCREEN) == 0) {
+        (void)SDL_SetWindowFullscreen(video->window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+    }
+
+    int display_index = SDL_GetWindowDisplayIndex(video->window);
+    SDL_Rect display_bounds = {0, 0, 0, 0};
+    SDL_bool have_display_bounds = display_index >= 0 && SDL_GetDisplayBounds(display_index, &display_bounds) == 0
+        && display_bounds.w > 0 && display_bounds.h > 0;
+
+    int window_width = 0, window_height = 0;
+    SDL_GetWindowSize(video->window, &window_width, &window_height);
+    if (have_display_bounds &&
+        (window_width < display_bounds.w || window_height < display_bounds.h)) {
+        SDL_SetWindowFullscreen(video->window, 0);
+        SDL_SetWindowBordered(video->window, SDL_FALSE);
+        SDL_SetWindowPosition(video->window, display_bounds.x, display_bounds.y);
+        SDL_SetWindowSize(video->window, display_bounds.w, display_bounds.h);
+        SDL_GetWindowSize(video->window, &window_width, &window_height);
+    }
+
+    video->renderer = SDL_CreateRenderer(video->window, -1, 0);
+    if (!video->renderer) {
+        PortMaster_CloseVideo(video);
+        return -1;
     }
