+
+    int output_width = 0, output_height = 0;
+    if (SDL_GetRendererOutputSize(video->renderer, &output_width, &output_height) != 0 ||
+        output_width <= 0 || output_height <= 0) {
+        SDL_GetWindowSize(video->window, &output_width, &output_height);
+    }
+    if ((output_width <= 0 || output_height <= 0) && have_display_bounds) {
+        output_width = display_bounds.w;
+        output_height = display_bounds.h;
+    }
+    if (output_width <= 0 || output_height <= 0) {
+        PortMaster_CloseVideo(video);
+        return SDL_SetError("Unable to determine handheld display size");
+    }
